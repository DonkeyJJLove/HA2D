{
  "schema_version": "1.0.0",
  "repository": {
    "id": "DonkeyJJLove/HA2D",
    "url": "https://github.com/DonkeyJJLove/HA2D",
    "owner": "DonkeyJJLove",
    "default_branch": "master",
    "vcs_ref": null
  },
  "cyber_lion": {
    "tile_id": "context-memory.ha2d",
    "roles": [
      "ContextMemoryLab",
      "MemoryCandidateProvider",
      "ReplayContextProvider",
      "ProcessStateDiagnostics"
    ],
    "layers": [
      "INF",
      "SEM"
    ],
    "disposition": [
      "KEEP",
      "REFINE",
      "EXPERIMENTAL",
      "INTEGRATE"
    ]
  },
  "capabilities": [
    "context.capture",
    "memory.candidate",
    "memory.replay",
    "semantic.revision",
    "process.diagnostics"
  ],
  "authority": {
    "maximum_level": "read",
    "required_gates": [
      "memory.commit.policy",
      "cyber-lion.mand"
    ]
  },
  "observability": {
    "logs": [
      "context.snapshot",
      "memory.candidate",
      "semantic.revision"
    ],
    "metrics": [
      "context.age",
      "candidate.count",
      "revision.count",
      "diagnostic.drift"
    ],
    "traces": [
      "working-context→candidate→review→commit/supersede"
    ]
  },
  "security": {
    "trust_boundaries": [
      "working context != committed memory",
      "semantic coherence != empirical truth",
      "diagnostic state != authority",
      "memory commit requires explicit policy and provenance"
    ]
  },
  "epistemic": {
    "status": "EXPERIMENTAL",
    "confidence": 0.74
  },
  "architecture_knowledge": {
    "schema_version": "1.0.0",
    "global_owner": "DonkeyJJLove/ai_platform",
    "semantic_exports": [
      "context_memory",
      "memory_semantics",
      "process_diagnostics"
    ],
    "semantic_imports": [
      "architecture",
      "contracts",
      "currentness"
    ],
    "repository_dependencies": [
      "DonkeyJJLove/ai_platform"
    ],
    "architecture_artifacts": [
      {
        "path": "AGENTS.md",
        "class": "HUMAN_ARCHITECTURE_DOCUMENT",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "AI_NATIVE_ROADMAP.md",
        "class": "ROADMAP",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "PROCESS_GUARD.md",
        "class": "PROCESS_GUARD",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "README.md",
        "class": "HUMAN_ARCHITECTURE_DOCUMENT",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "REPOSITORY_STANDARDIZATION_R1.json",
        "class": "MACHINE_READABLE_ARCHITECTURE",
        "currentness": "LOCAL_OWNER"
      }
    ],
    "discoverability": {
      "entrypoint": "AGENTS.md",
      "global_owner_route": "AGENTS.md -> cyber-lion.repository.json -> DonkeyJJLove/ai_platform:LION/architecture/v1_5/README.md",
      "max_reads_to_global_owner": 3
    },
    "invalidation_triggers": [
      "SOURCE_CHANGE",
      "CONTRACT_CHANGE",
      "CAPABILITY_CHANGE",
      "CURRENTNESS_CHANGE",
      "REPOSITORY_ROLE_CHANGE",
      "DEPENDENCY_CHANGE",
      "NAMING_STANDARD_CHANGE"
    ]
  }
}
